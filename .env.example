# StreamNative Cloud connection. Copy this file to .env (git-ignored), fill it in, then run
# `docker compose up -d --build`: the producer publishes to the cloud and the dashboard reads from it.
# Leave the values empty to use the local Kafka and Schema Registry.
# Never put real values in this file: it is committed.

# Kafka Service URL from the cluster dashboard, e.g. pc-1234abcd.gcp-shared-usce1.g.snio.cloud:9093
KAFKA_SERVICE_URL=

# Schema Registry URL. Kafka cluster: the registry's own URL. Pulsar cluster: the cluster's
# HTTP Service URL with /kafka appended, e.g. https://pc-1234abcd.gcp-shared-usce1.g.snio.cloud/kafka
SCHEMA_REGISTRY_URL=

# API key (JWT) of a service account with produce + consume permission on the topic
# and the schema-writer role.
JWT_TOKEN=

# Kafka cluster: the service account the API key belongs to (`userName` in the console's
# client example), e.g. my-sa@o-abcde.auth.streamnative.cloud. Pulsar cluster: leave empty.
KAFKA_USERNAME=
