# Copy this file to .env (git-ignored) and fill it in. Never put real values here: this file is committed.

# StreamNative Cloud, from the cluster's client example in the console.
# Kafka Service URL, e.g. c-1234abcd.aws-usw2a-abcd.aws.snio.cloud:9093
KAFKA_SERVICE_URL=
# Schema Registry URL, e.g. https://c-1234-schema-registry.aws-usw2a-abcd.aws.snio.cloud
SCHEMA_REGISTRY_URL=
# API key (JWT) of a service account with produce permission on the topic and the schema-writer role
JWT_TOKEN=
# The service account the API key belongs to (`userName` in the console's example), e.g. my-sa@o-abcde.auth.streamnative.cloud
KAFKA_USERNAME=

# RisingWave: connection string of the database holding the materialized view,
# e.g. postgresql://USER:PASSWORD@HOST:4566/dev
RISINGWAVE_URL=
# Name of the materialized view (default: hn-events_mv)
RISINGWAVE_MV=
